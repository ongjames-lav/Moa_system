{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/guest", "destination": "/guest.html" },
    { "source": "/student-management", "destination": "/student-management.html" },
    { "source": "/student-management.html", "destination": "/student-management.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
